// Both OS entrypoints run the canonical Ziran Terminal host and frame.
#scope_module
Host :: #import "app_host";
Clipboard :: #import "app_clipboard";
Runtime :: #import "kryon/Raylib";
View :: #import "app_terminal_view";
Window :: #import "app_window";
Launch :: #import "app_launch_options";
Frames :: #import "kryon/session";
Frame :: #import "kryon/Frame";
InputSnapshot :: #import "kryon/frame_snapshot";
Bytes :: #import "std/byte_text_linux";
Files :: #import "std/file_linux";
libc :: #system_library "c";
Allocate :: (count: usize, size: usize) -> *void #foreign libc "calloc";
Release :: (memory: *void) #foreign libc "free";
ArgumentView :: struct { data: *string; count: s64; }

Error :: (message: string, status: s32 = 1) -> s32 {
    file: Files.FileHandle = .{2, true}
    Files.Write(file, Window.ByteView(message))
    Files.Write(file, Window.ByteView("\n"))
    return status
}
// Frames drawn after the last event, for chrome that follows it by a frame.
SettleSeconds :: 0.05;
// Clipboard, title and theme changes still arrive while a window sleeps.
HostPollSeconds :: 0.1;
FloodPaintSeconds :: 0.016;
Run :: (arguments: []string) -> s32 {
    host: Host.Host
    defer Host.Close(*host)
    error: [256]u8
    parsed := Host.Prepare(*host, arguments, error[:])
    if parsed == Launch.ParseResult.ParseHelp { Launch.PrintUsage(); return 0 }
    if parsed == Launch.ParseResult.ParseVersion { Launch.PrintVersion(); return 0 }
    if parsed == Launch.ParseResult.ParseColorTable { Launch.PrintColorTable(); return 0 }
    if parsed != Launch.ParseResult.ParseOk {
        return Error(Bytes.TextFromCString(*error[0]), 2)
    }
    if Window.ForwardToRill() { return 0 }
    if !Window.Open(*host.app.launch) {
        Window.Close()
        return Error("Terminal: could not open the graphics window")
    }
    defer Window.Close()
    Window.LoadFont(*host.app.config)
    idle := Window.IdleRate(); active := Window.ActiveRate(idle)
    host.burst_ms = Window.BurstMilliseconds()
    start := Window.Now()
    View.prepare_glyphs = Runtime.RaylibPrepareGlyphs
    if !Host.Start(*host, Window.Bounds(), start) { return Error("Terminal: could not start Terminal") }
    Window.FitGeometry(*host.app.launch, Host.GridWindow(*host, Window.Bounds()))
    session := Frames.SessionOpen()
    if !Frames.SessionValid(session) { return Error("Terminal: could not open a UI session") }
    defer Frame.CloseSession(session)
    Window.Title(Host.Title(*host))
    capture := Window.CaptureRequested()
    // Nothing changes between events, so an idle window sleeps instead of
    // drawing. Wake for text blink and this window's cursor blink deadline.
    settle_until: float64; next_tick: float64; painted: float64; waits := !capture
    input_frames: s32
    shells: [64]s32
    while Window.Poll() {
        now := Window.Now()
        if Window.Drops(*host) { input_frames = 2; settle_until = now + SettleSeconds }
        polled := Host.Poll(*host, now)
        if polled.title_changed { Window.Title(Host.Title(*host)) }
        if polled.quit { break }
        if polled.bytes > 0 {
            settle_until = now + SettleSeconds
            // More output is likely on its way: read it instead of painting
            // twice in one display frame. The first byte after a pause paints now.
            if now - painted < FloodPaintSeconds { continue }
        }
        if waits && !host.busy && input_frames == 0 && now >= settle_until && now < next_tick {
            remaining := next_tick - now
            if remaining > HostPollSeconds { remaining = HostPollSeconds }
            woke := Window.Wait(shells[0:Host.Descriptors(*host, shells[:])], remaining)
            if woke == Runtime.RaylibActivityUnsupported { waits = false }
            else {
                // A frame reads input at its end and uses it in the next.
                if woke == Runtime.RaylibActivityInput { input_frames = 2 }
                continue
            }
        }
        if input_frames > 0 { input_frames -= 1 }
        painted = now
        Window.Begin()
        bounds := Window.Bounds()
        down: [512]s32
        unused Runtime.RaylibFrameInputBegin(session)
        device := Window.Sample(session, now, down[:])
        if cast(s32)Host.BeginFrame(*host, session, cast(u64)1, bounds, device.focused) != 0 {
            InputSnapshot.FrameInputEnd(session)
            Window.End()
            return Error("Terminal: could not begin a UI frame")
        }
        result := Host.Draw(*host, session, bounds, device)
        next_tick = View.NextTick(host.app, now)
        if cast(s32)Frame.EndFrame(session) != 0 {
            InputSnapshot.FrameInputEnd(session)
            Window.End()
            return Error("Terminal: could not draw the UI frame")
        }
        InputSnapshot.FrameInputEnd(session)
        Window.Apply(result.input, host.app)
        if result.font_changed { Window.LoadFont(*host.app.config) }
        if result.title_changed { Window.Title(Host.Title(*host)) }
        captured: bool
        if capture && now - start >= 0.1 { captured = Window.Capture() }
        if !Window.End() { return Error("Terminal: could not present the UI frame") }
        if capture && now - start >= 0.1 {
            if captured { return 0 }
            return Error("Terminal: could not save the window capture")
        }
        if result.quit { break }
        if result.input.wrote > 0 { settle_until = now + SettleSeconds }
        Window.Rate(ifx now < host.fast_poll_until then active else idle)
    }
    return 0
}
Main :: (argc: s32, argv: **s8) -> s32 {
    if argc <= 0 || argv == null { return Error("Terminal: missing process arguments", 2) }
    data := cast(*string)Allocate(cast(usize)argc, cast(usize)size_of(string))
    if data == null { return Error("Terminal: could not allocate process arguments") }
    defer Release(cast(*void)data)
    for index: 0..argc - 1 { data[index] = Bytes.TextFromCString(cast(*u8)argv[index]) }
    arguments: []string
    view := cast(*ArgumentView)(*arguments)
    view.data = data; view.count = cast(s64)argc
    return Run(arguments)
}
#scope_export
#program_export
main :: (argc: s32, argv: **s8) -> s32 { return Main(argc, argv) }
