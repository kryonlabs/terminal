// The native window reads an explicitly pasted image; no desktop capture.
#scope_module
File :: #import "std/file_linux";
Text :: #import "std/byte_text_linux";
CString :: #import "std/c_string";
Random :: #import "std/random_linux";
Clock :: #import "std/timer_linux";
using V :: #import "std/vec";
gtk :: #system_library "gtk-3";
gdk :: #system_library "gdk-3";
glib :: #system_library "glib-2.0";
libc :: #system_library "c";
Init :: (argc: *s32, argv: ***u8) -> s32 #foreign gtk "gtk_init_check";
Atom :: (name: *u8) -> *void #foreign gdk "gdk_atom_intern_static_string";
Clipboard :: (selection: *void) -> *void #foreign gtk "gtk_clipboard_get";
Received :: #type (clipboard: *void, data: *void, userdata: *void) -> void #c_call;
Request :: (clipboard: *void, target: *void, callback: Received, userdata: *void) #foreign gtk "gtk_clipboard_request_contents";
Data :: (selection: *void) -> *u8 #foreign gtk "gtk_selection_data_get_data";
Length :: (selection: *void) -> s32 #foreign gtk "gtk_selection_data_get_length";
Iterate :: (context: *void, block: s32) -> s32 #foreign glib "g_main_context_iteration";
Allocate :: (size: usize) -> *u8 #foreign libc "malloc";
Release :: (memory: *void) #foreign libc "free";
Environment :: (name: *u8) -> *u8 #foreign libc "getenv";
Rename :: (from: *u8, to: *u8) -> s32 #foreign libc "rename";
Remove :: (path: *u8) -> s32 #foreign libc "remove";
path_bytes: [4096]u8;
generation: usize;
finished: bool;
image: *u8;
image_size: s32;
Bytes :: (value: string) -> *u8 { descriptor:=cast(*Text.TextDescriptor)(*value); return descriptor.data }
Complete :: (clipboard: *void, selection: *void, userdata: *void) {
    if cast(usize)userdata!=generation { return }
    finished=true; size:=Length(selection); data:=Data(selection)
    if data==null || size<8 || size>33554432 { return }
    signature: [8]u8=.{137,80,78,71,13,10,26,10}
    for i: 0..7 { if data[i]!=signature[i] { return } }
    image=Allocate(cast(usize)size); if image==null { return }
    for i: 0..size-1 { image[i]=data[i] }; image_size=size
}
#scope_export
Path :: () -> string {
    if Init(null,null)==0 { return "" }
    generation+=1; finished=false; image=null; image_size=0
    callback: Received=Complete
    Request(Clipboard(Atom(Bytes("CLIPBOARD"))),Atom(Bytes("image/png")),callback,cast(*void)generation)
    deadline:=Clock.MonotonicMilliseconds()+800
    while !finished && Clock.MonotonicMilliseconds()<deadline { unused Iterate(null,0); Clock.SleepMilliseconds(1) }
    generation+=1
    if image==null { return "" }
    defer { Release(cast(*void)image); image=null; image_size=0 }
    home:=Environment(Bytes("XDG_CACHE_HOME")); root:=ifx home!=null then Text.TextFromCString(home) else ""
    out: Vec(u8)
    if root=="" { home=Environment(Bytes("HOME")); if home==null { return "" }; BuilderPrint(*out,"%/.cache",Text.TextFromCString(home)) }
    else { BuilderPrint(*out,"%",root) }
    BuilderPrint(*out,"/terminal/clipboard")
    folder:=BuilderFinish(out); defer { Release(cast(*void)Bytes(folder)) }
    for i: 1..cast(s32)folder.count-1 { if folder[i]==47 && !File.CreatePrivateDirectory(folder[:i]) { return "" } }
    if !File.CreatePrivateDirectory(folder) { return "" }
    random: [16]u8; if !Random.FillSecure(random[:]) { return "" }
    name: Vec(u8); BuilderPrint(*name,"%/",folder); digits: string="0123456789abcdef"
    for byte: random { at:=cast(s32)byte; BuilderPrint(*name,"%",digits[at/16:at/16+1]); BuilderPrint(*name,"%",digits[at%16:at%16+1]) }
    BuilderPrint(*name,".png"); path:=BuilderFinish(name); defer { Release(cast(*void)Bytes(path)) }
    if !CString.CopyCString(path,path_bytes[:]) { return "" }
    file:=File.OpenReplace(path); if !file.valid { return "" }
    used: s64
    while used<cast(s64)image_size {
        count:=File.Write(file,Text.BytesFromPointer(*image[used],cast(u64)(image_size)-cast(u64)used))
        if count<=0 { break }; used+=count
    }
    closed:=File.CloseFile(file)
    if !closed || used!=cast(s64)image_size { unused Remove(*path_bytes[0]); return "" }
    return Text.TextFromCString(*path_bytes[0])
}
