// A read-only projection borrows complete source cells instead of allocating
// another history grid. Rebuild after feeding/resizing/changing the source;
// the source must outlive the projection. No PTY, parser or source field is
// modified, including for attached terminals.
#scope_module
#scope_export
TerminalViewportRow :: struct { first: s32; count: s32; wrapped: s32 }
TerminalViewport :: struct {
    source: *Terminal
    lines: *TerminalViewportRow
    capacity: s32
    cols: s32
    rows: s32
    history_rows: s32
    main_count: s32
    first: s32
    total_rows: s32
    cursor_col: s32
    cursor_row: s32
    source_cols: s32
    source_history: s32
    pending_first: s32
    pending_count: s32
    blank: Cell
}
#scope_module
viewport_emit :: (view: *TerminalViewport, wrapped: s32) {
    slot := view.total_rows % view.capacity
    view.lines[slot] = .{view.pending_first, view.pending_count, wrapped}
    view.total_rows += 1; view.pending_first = 0; view.pending_count = 0
}
viewport_append :: (view: *TerminalViewport, first: s32, count: s32, soft: s32) {
    at: s32
    while at < count {
        if view.pending_count >= view.cols { viewport_emit(view, 1) }
        if view.pending_count == 0 { view.pending_first = first + at }
        take := view.cols - view.pending_count
        if take > count - at { take = count - at }
        view.pending_count += take; at += take
    }
    if soft == 0 { viewport_emit(view, 0) }
}
#scope_export
#program_export
terminal_viewport_close :: (view: *TerminalViewport) {
    if view == null { return }
    free(cast(*void)view.lines); memset(cast(*void)view, 0, size_of(TerminalViewport))
}
#program_export
terminal_viewport_build :: (view: *TerminalViewport, source: *Terminal,
cols: s32, rows: s32) -> bool {
    if view == null || source == null || source.main_cells == null ||
       source.cols <= 0 || source.cols > MAX_COLS || source.rows <= 0 || source.rows > MAX_ROWS ||
       source.scrollback_count < 0 || source.scrollback_count > source.scrollback_capacity ||
       (source.scrollback_count > 0 && source.scrollback == null) ||
       (source.alternate_screen != 0 && source.alt_cells == null) { return false }
    cols = terminal_clamp_int(cols, 8, MAX_COLS); rows = terminal_clamp_int(rows, 4, MAX_ROWS)
    limit := ifx source.scrollback_limit > 0 then source.scrollback_limit else SCROLLBACK_LIMIT
    if limit > 1000000 { return false }
    history := ifx source.alternate_screen != 0 then 0 else source.scrollback_count
    reflow := source.alternate_screen == 0 && source.cols != cols
    kept := history
    if !reflow && source.cols == cols && source.rows != rows && source.scrollback_capacity != limit && kept > limit { kept = limit }
    capacity := (ifx reflow && history > 0 then limit else kept) + rows
    candidate: TerminalViewport
    candidate.lines = view.lines; candidate.capacity = capacity
    if view.lines == null || view.capacity != capacity {
        candidate.lines = cast(*TerminalViewportRow)malloc(cast(usize)capacity * size_of(TerminalViewportRow))
        if candidate.lines == null { return false }
    }
    candidate.source = source; candidate.cols = cols; candidate.rows = rows
    candidate.source_cols = source.cols; candidate.source_history = history
    candidate.blank = terminal_blank_cell(source)
    candidate.cursor_col = terminal_clamp_int(source.cursor_col, 0, cols - 1)
    candidate.cursor_row = terminal_clamp_int(source.cursor_row, 0, rows - 1)
    if !reflow {
        for row: 0..kept - 1 {
            logical := history - kept + row
            soft := terminal_visible_line_wrapped(source, logical)
            viewport_append(*candidate, logical * source.cols, source.cols, 0)
            candidate.lines[(candidate.total_rows - 1) % capacity].wrapped = soft
        }
        copy_rows := ifx source.rows < rows then source.rows else rows
        copy_cols := ifx source.cols < cols then source.cols else cols
        for row: 0..copy_rows - 1 {
            // Height-only and alternate-screen resize crop without reflow.
            viewport_append(*candidate, (history + row) * source.cols, copy_cols, 0)
            candidate.lines[(candidate.total_rows - 1) % capacity].wrapped = terminal_visible_line_wrapped(source, history + row)
        }
        candidate.history_rows = kept; candidate.main_count = copy_rows
    } else {
        for row: 0..history - 1 {
            physical := (source.scrollback_head - history + row + source.scrollback_capacity) % source.scrollback_capacity
            soft := ifx source.scrollback_wrapped != null then cast(s32)source.scrollback_wrapped[physical] else 0
            end := row_text_end(source.scrollback, source.cols, physical, soft)
            viewport_append(*candidate, row * source.cols, end, soft)
        }
        prefix_rows := candidate.total_rows; prefix_col := candidate.pending_count
        metadata: [120]PaneCursor.TerminalPaneReflowRow
        for row: 0..source.rows - 1 {
            soft := source.main_wrapped != null && source.main_wrapped[row] != 0
            metadata[row] = .{row_text_end(source.main_cells, source.cols, row, cast(s32)soft), soft}
        }
        cursor_x := terminal_clamp_int(source.cursor_col, 0, source.cols - 1)
        cursor_y := terminal_clamp_int(source.cursor_row, 0, source.rows - 1)
        count := source.rows
        while count > cursor_y + 1 && !metadata[count - 1].wrapped && metadata[count - 1].end == 0 { count -= 1 }
        for row: 0..count - 1 {
            viewport_append(*candidate, (history + row) * source.cols, metadata[row].end, cast(s32)metadata[row].wrapped)
        }
        if candidate.pending_count > 0 { viewport_emit(*candidate, 0) }
        mapped := PaneCursor.MeasureTerminalPaneReflowCursor(metadata[:count], cols, cursor_x, cursor_y, true, prefix_col)
        copy_rows := ifx candidate.total_rows < rows then candidate.total_rows else rows
        start := candidate.total_rows - copy_rows
        cursor := prefix_rows + mapped.row
        if cursor >= start && cursor < start + copy_rows {
            candidate.cursor_row = cursor - start
            candidate.cursor_col = terminal_clamp_int(mapped.col, 0, cols - 1)
        } else if history == 0 { candidate.cursor_row = terminal_clamp_int(source.cursor_row, 0, copy_rows - 1) }
        candidate.main_count = copy_rows
        if history > 0 { candidate.history_rows = terminal_clamp_int(start, 0, limit) }
        candidate.first = start - candidate.history_rows
    }
    if candidate.lines != view.lines { free(cast(*void)view.lines) }
    view.* = candidate; return true
}
#program_export
terminal_viewport_line_count :: (view: *TerminalViewport) -> s32 {
    if view == null || view.source == null { return 0 }; return view.history_rows + view.rows
}
#program_export
terminal_viewport_cell :: (view: *TerminalViewport, col: s32, row: s32) -> *Cell {
    if view == null || view.source == null || view.lines == null || col < 0 || col >= view.cols ||
       row < 0 || row >= terminal_viewport_line_count(view) { return null }
    if row >= view.history_rows + view.main_count { return *view.blank }
    line := view.lines[(view.first + row) % view.capacity]
    if col >= line.count { return *view.blank }
    index := line.first + col
    return terminal_visible_cell(view.source, index % view.source_cols, index / view.source_cols)
}
#program_export
terminal_viewport_line_wrapped :: (view: *TerminalViewport, row: s32) -> s32 {
    if view == null || view.lines == null || row < 0 || row >= view.history_rows + view.main_count { return 0 }
    return view.lines[(view.first + row) % view.capacity].wrapped
}
#program_export
terminal_viewport_line :: (view: *TerminalViewport, row: s32, out: *u8, out_size: s32) {
    if out == null || out_size <= 0 { return }; out[0] = 0
    if view == null || row < 0 || row >= terminal_viewport_line_count(view) { return }
    end := view.cols
    while end > 0 {
        cell := terminal_viewport_cell(view, end - 1, row)
        if cell == null || cell.codepoint != cast(u32)32 { break }; end -= 1
    }
    used: s32
    for col: 0..end - 1 {
        cell := terminal_viewport_cell(view, col, row)
        if cell == null { break }; if (cell.style & STYLE_WIDE_CONT) != 0 { continue }
        cp := ifx cell.codepoint == 0 then cast(u32)32 else cell.codepoint
        if cast(s32)PaneText.AppendTerminalPaneUTF8Codepoint(out, out_size, *used, cp) == 0 { break }
        if cell.combining != 0 && cast(s32)PaneText.AppendTerminalPaneUTF8Codepoint(out, out_size, *used, cell.combining) == 0 { break }
    }
    out[used] = 0
}
